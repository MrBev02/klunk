.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp

# Python (the generators in tools/)
__pycache__/
*.py[cod]
.venv/
venv/

# Local de-risking spike for #3, never committed
spike/
spike-dist-single/
vite.spike.config.ts
