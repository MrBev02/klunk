{
  "name": "klunk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Klunk builds exam papers from a question bank. Runs entirely in the browser, no server, no API keys.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:corpus": "vitest run --mode corpus",
    "test:watch": "vitest",
    "build": "tsc --noEmit && vitest run && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "build:all": "npm run build && npm run build:single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "katex": "^0.19.1",
    "pdfjs-dist": "^6.5.438",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@types/wicg-file-system-access": "^2023.10.7",
    "preact-render-to-string": "^6.8.2",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
