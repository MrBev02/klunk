{
  "name": "klunk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Klunk builds exam papers from a question bank. Runs entirely in the browser, no server, no API keys.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "build:all": "npm run build && npm run build:single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/wicg-file-system-access": "^2023.10.7",
    "typescript": "^5.6.0",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
